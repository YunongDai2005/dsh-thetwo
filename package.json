{
  "name": "dsh-thetwo",
  "version": "0.1.1",
  "type": "module",
  "description": "Sync DeepSeek Harness conversations and attachments over a LAN and hand tasks to a paired device. 局域网会话同步与跨设备任务交接。",
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "dsh", "lan", "session-sync", "task-handoff", "会话同步", "任务交接"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunongDai2005/dsh-thetwo.git"
  },
  "homepage": "https://github.com/YunongDai2005/dsh-thetwo#readme",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:integration": "node --test test/*.integration.mjs",
    "test:all": "node --test test/*.test.mjs test/*.integration.mjs",
    "check": "node scripts/check.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "verify:install": "node scripts/verify-install.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "latest",
    "jsdom": "26.1.0",
    "react-dom": "18.3.1"
  }
}
